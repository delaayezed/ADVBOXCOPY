{
  "manifest_version": 3,
  "name": "Copiar dados do ADVBOX",
  "version": "1.0.0",
  "description": "Adiciona controles de cópia aos dados exibidos nas tarefas do ADVBOX.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.advbox.com.br/*"],
      "js": ["src/icons.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
